{
  "version": "2.0",
  "extensions": {
    "mcp": {
      "serverName": "Profile Summary Tools",
      "serverVersion": "1.0.0",
      "instructions": "Use get_my_profile only for the signed-in user's own profile.",
      "system": {
        "webhookAuthorizationLevel": "Anonymous"
      }
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  }
}